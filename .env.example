# All values marked REQUIRED have no default: `docker compose` refuses to start if they are empty.
# start-prod.ps1 generates random values for the empty ones (never printed).

# Postgres
POSTGRES_USER=postgres
# REQUIRED. Generate with: openssl rand -base64 24 | tr -d '/+=\n'   (avoid '$' and quotes)
# NOTE: only applied when the pgdata volume is created; changing it later does NOT change the
# password of an existing database (see docs/configuration_deploy_debug.md, "Migrazione").
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Backend auth - REQUIRED, no default: the backend refuses to start if empty.
# Generate one with: openssl rand -base64 48   (keep it stable across restarts)
JWT_SECRET=

# Backend database connection (backend password comes from POSTGRES_PASSWORD in compose)
PG_HOST=postgres
PG_PORT=5432
PG_DB=tenant_db_1
PG_USER=postgres
# PG_PASSWORD: only for running the backend OUTSIDE compose; must equal POSTGRES_PASSWORD.
PG_PASSWORD=

# MinIO
# REQUIRED (root user). Generate with: openssl rand -hex 8
MINIO_ROOT_USER=
# REQUIRED. Generate with: openssl rand -base64 24 | tr -d '/+=\n'
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=models
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_SSL=false
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY: only for running the backend OUTSIDE compose; must equal
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (compose maps them automatically).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Demo data (OPT-IN, never on real databases): `docker compose --profile demo up`
# REQUIRED only with the demo profile, no default. argon2id hash of the demo users' password.
# Generate: cd backend && bun -e "console.log(await Bun.password.hash(process.argv[1]))" 'YourPassword'
# In .env wrap the value in SINGLE quotes (it contains '$'): DEMO_PASSWORD_HASH='$argon2id$v=19$...'
DEMO_PASSWORD_HASH=

# Resend email (optional – if not set, password reset emails are skipped)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
